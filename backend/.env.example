DATABASE_URL="postgresql://usuario:senha@localhost:5432/conecta_jovem?schema=public"
JWT_SECRET=""
PORT=3000

# Pasta dos documentos enviados pelas empresas (US06). Em branco usa backend/uploads/documentos.
PASTA_DOCUMENTOS=""

# HTTPS (TS02). Deixe em branco para rodar só em HTTP no dia a dia.
# Para testar HTTPS local, gere o certificado (veja o README) e preencha:
HTTPS_CERT=""
HTTPS_KEY=""
HTTP_PORT=3080
# Na hospedagem, true: redireciona HTTP para HTTPS e envia o cabeçalho HSTS.
FORCAR_HTTPS=false
